# Paths are relative to this file; ~ is also supported.
name = "sello"

[[agents]]
id = "android"
folder = "./sello-dev"
agent = "codex"
role = "Android, web and server implementation; coordinate API changes with ios."

[[agents]]
id = "ios"
folder = "./sello-ios"
agent = "copilot"
role = "Native iOS app; coordinate shared API changes with android."
