#!/usr/bin/env python3
"""Small tmux launcher for project-local CLI agent teams."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import signal
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import tomllib
import uuid

SCRIPT = Path(__file__).resolve()
STATE = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'xcontrol'
BUILTINS = ('codex', 'copilot', 'claude')


def executable(value):
    return isinstance(value, str) and re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.+-]*', value) and value != 'auto'


def argv(value):
    return isinstance(value, list) and all(isinstance(arg, str) and '\x00' not in arg for arg in value)


def run(*args, check=True):
    return subprocess.run(list(args), text=True, capture_output=True, check=check)


def tmux(*args, check=True):
    return run('tmux', *args, check=check).stdout.strip()


def load(filename):
    path = Path(filename).expanduser().resolve(strict=True)
    with path.open('rb') as stream:
        config = tomllib.load(stream)
    if set(config) - {'name', 'agents', 'availability'}:
        raise ValueError('Config supports only name, [[agents]], and [availability].')
    checks = config.get('availability', {})
    if not isinstance(checks, dict) or any(not executable(engine) or not argv(cmd) or not cmd or not cmd[0] for engine, cmd in checks.items()):
        raise ValueError('availability maps CLI names to nonempty argument lists.')
    name = config.get('name', path.stem)
    if not isinstance(name, str) or not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_-]*', name):
        raise ValueError('name must contain letters, numbers, underscores or hyphens.')
    agents = config.get('agents', [])
    if not isinstance(agents, list) or not 1 <= len(agents) <= 16:
        raise ValueError('Define between 1 and 16 [[agents]].')
    seen = set()
    workspaces = set()
    for agent in agents:
        if not isinstance(agent, dict) or set(agent) - {'id', 'folder', 'agent', 'role', 'resume', 'args', 'candidates', 'prompt', 'bypass'}:
            raise ValueError('Agent fields: id, folder, agent, role, resume, args, candidates, prompt, bypass.')
        ident = agent.get('id', '')
        if not isinstance(ident, str) or not re.fullmatch(r'[A-Za-z0-9_-]+', ident) or ident in seen:
            raise ValueError('Each agent needs a unique id of letters, numbers, _ or -.')
        seen.add(ident)
        engine = agent.get('agent', 'codex')
        if engine != 'auto' and not executable(engine):
            raise ValueError('agent must be an executable name on PATH, without shell syntax or paths.')
        if 'bypass' in agent and (type(agent['bypass']) is not bool or engine not in ('codex', 'auto')):
            raise ValueError('bypass must be a boolean and applies to Codex or auto agents only.')
        extra_args = agent.get('args', [])
        if not argv(extra_args):
            raise ValueError('args must be a list of strings without NUL bytes.')
        candidates = agent.get('candidates', list(BUILTINS))
        if engine == 'auto':
            if not isinstance(candidates, list) or not candidates or any(not executable(c) for c in candidates) or len(set(candidates)) != len(candidates):
                raise ValueError('candidates must be a nonempty list of unique CLI names.')
            if extra_args or agent.get('resume', 'auto') not in ('auto', 'new'):
                raise ValueError('Auto agents use resume = auto or new and no CLI-specific args.')
        elif 'candidates' in agent:
            raise ValueError('candidates applies only to agent = auto.')
        folder = agent.get('folder')
        if not isinstance(folder, str) or not folder:
            raise ValueError('Each agent needs a folder.')
        cwd = Path(folder).expanduser()
        cwd = (path.parent / cwd).resolve()
        if not cwd.is_dir():
            raise ValueError(f'Folder does not exist: {cwd}')
        key = (engine, str(cwd))
        if key in workspaces:
            raise ValueError('Use separate folders/worktrees for agents using the same CLI.')
        workspaces.add(key)
        builtin = engine in BUILTINS or engine == 'auto'
        resume = agent.get('resume', 'auto' if builtin else 'new')
        if not builtin and resume != 'new':
            raise ValueError('Custom agents use resume = new; configure their native resume flags in args.')
        if not isinstance(resume, str) or (resume not in ('auto', 'new') and not re.fullmatch(r'[0-9a-fA-F-]{36}', resume)):
            raise ValueError('resume must be auto, new, or a session UUID.')
        if 'prompt' in agent:
            prompt = agent['prompt']
            if not isinstance(prompt, str) or not prompt.strip() or len(prompt.encode()) > 65536:
                raise ValueError('prompt must be nonempty text of at most 64 KiB.')
            if resume != 'new' or (engine not in BUILTINS and engine != 'auto') or (engine == 'auto' and any(c not in BUILTINS for c in candidates)):
                raise ValueError('Initial prompts require resume = new and Codex, Copilot, or Claude candidates.')
        if not isinstance(agent.get('role', ''), str):
            raise ValueError('role must be text.')
        agent.update(agent=engine, folder=str(cwd), resume=resume, args=extra_args,
                     candidates=candidates, checks=checks)
    digest = hashlib.sha256(str(path).encode()).hexdigest()[:10]
    return path, f'xc-{name}-{digest}', agents


def probe_command(engine):
    prompt = 'Reply with exactly XCONTROL_OK. Do not use tools or inspect files.'
    commands = {
        'codex': ['codex', 'exec', '--ephemeral', '--skip-git-repo-check',
                  '--sandbox', 'read-only', '--json', prompt],
        'claude': ['claude', '-p', prompt, '--tools', '', '--strict-mcp-config',
                   '--mcp-config', '{"mcpServers":{}}', '--no-session-persistence',
                   '--output-format', 'json', '--settings', '{"disableAllHooks":true}'],
        'copilot': ['copilot', '-p', prompt, '--silent', '--available-tools=',
                    '--disable-builtin-mcps', '--no-custom-instructions'],
    }
    return commands.get(engine)


def probe_success(engine, output):
    """Require an actual successful model answer, never just exit status."""
    try:
        if engine == 'claude':
            result = json.loads(output)
            return (result.get('type') == 'result' and not result.get('is_error')
                    and result.get('result', '').strip() == 'XCONTROL_OK')
        if engine == 'codex':
            events = [json.loads(line) for line in output.splitlines() if line.strip()]
            return (any(e.get('type') == 'turn.completed' for e in events)
                    and not any(e.get('type') in ('error', 'turn.failed') for e in events)
                    and any(e.get('type') == 'item.completed'
                            and e.get('item', {}).get('type') == 'agent_message'
                            and e['item'].get('text', '').strip() == 'XCONTROL_OK'
                            for e in events))
        return output.strip() == 'XCONTROL_OK'
    except (ValueError, TypeError, AttributeError):
        return False


def model_availability(engine, timeout=30):
    command = probe_command(engine)
    if command is None:
        return 'unknown'
    # Keep project instructions and probe conversations out of real workspaces.
    with tempfile.TemporaryDirectory(prefix='xc-probe-') as cwd:
        for attempt in range(2):
            with tempfile.TemporaryFile() as output:
                try:
                    with subprocess.Popen(command, cwd=cwd, stdin=subprocess.DEVNULL,
                                          stdout=output, stderr=subprocess.DEVNULL,
                                          start_new_session=True) as proc:
                        try:
                            code = proc.wait(timeout=timeout)
                        except subprocess.TimeoutExpired:
                            os.killpg(proc.pid, signal.SIGKILL)
                            proc.wait()
                            code = -1
                        output.seek(0)
                        answer = output.read(1048577)
                        if code == 0 and len(answer) <= 1048576 and probe_success(engine, answer.decode('utf-8', errors='replace')):
                            return 'available'
                except OSError:
                    pass
    # Failure means unusable for this launch, not permanent account exhaustion.
    return 'unavailable'


def availability(engine, checks, cwd):
    if not shutil.which(engine):
        return 'not installed'
    try:
        if engine in checks:
            # Suppress checker output: it may contain account details or credentials.
            code = subprocess.run(checks[engine], cwd=cwd, stdin=subprocess.DEVNULL,
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                  timeout=5).returncode
            return {0: 'available', 1: 'unavailable'}.get(code, 'unknown')
        return model_availability(engine)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return 'unknown'


def resolve_agents(agents, path):
    cache, resolved = {}, []
    for agent in agents:
        chosen = dict(agent)
        if agent['agent'] == 'auto':
            for candidate in agent['candidates']:
                if candidate not in cache:
                    cache[candidate] = availability(candidate, agent['checks'], path.parent)
                state = cache[candidate]
                print(f"{agent['id']}: {candidate}: {state}", file=sys.stderr)
                if state == 'available':
                    chosen['agent'] = candidate
                    if candidate not in BUILTINS:
                        chosen['resume'] = 'new'
                    break
            else:
                raise ValueError(f"{agent['id']}: no candidate has confirmed working model access. Configure [availability] checks or select an agent explicitly.")
        if not shutil.which(chosen['agent']):
            raise ValueError('Missing dependency: ' + chosen['agent'])
        resolved.append(chosen)
    keys = [(a['agent'], a['folder']) for a in resolved]
    if len(set(keys)) != len(keys):
        raise ValueError('Auto selection resolved to duplicate CLI/folder pairs; use separate worktrees.')
    return resolved


def latest_codex(cwd):
    home = Path(os.environ.get('CODEX_HOME', str(Path.home() / '.codex')))
    dbs = [p for p in home.glob('state_*.sqlite') if p.stem[6:].isdigit()]
    if not dbs:
        return None
    db = max(dbs, key=lambda p: int(p.stem[6:]))
    try:
        with sqlite3.connect(db.resolve().as_uri() + '?mode=ro', uri=True, timeout=2) as conn:
            row = conn.execute("SELECT id FROM threads WHERE cwd=? AND source='cli' AND archived=0 ORDER BY updated_at DESC LIMIT 1", (cwd,)).fetchone()
            return row[0] if row else None
    except sqlite3.Error:
        print('Warning: cannot read Codex session metadata; starting a new conversation.', file=sys.stderr)
        return None


def command(agent):
    engine, resume = agent['agent'], agent['resume']
    extra = list(agent.get('args', []))
    if agent.get('prompt'):
        extra += (['-i', agent['prompt']] if engine == 'copilot' else [agent['prompt']])
    if engine not in ('codex', 'claude', 'copilot'):
        return [engine, *extra]
    if engine == 'codex':
        sid = latest_codex(agent['folder']) if resume == 'auto' else (None if resume == 'new' else resume)
        return ['codex', *(['resume'] if sid else []), '--no-daemon', *(['--dangerously-bypass-approvals-and-sandbox'] if agent.get('bypass', True) else []), '-C', agent['folder'], *([sid] if sid else []), *extra]
    if engine == 'copilot' and resume == 'auto':
        # Copilot accepts a UUID for either a new or an existing session.
        # A workspace-specific ID avoids resuming an unrelated global session.
        sid = str(uuid.uuid5(uuid.NAMESPACE_URL, 'xcontrol:copilot:' + agent['folder']))
        return ['copilot', '--session-id', sid, *extra]
    return [engine, *(['--continue'] if resume == 'auto' else []), *(['--resume', resume] if resume not in ('auto', 'new') else []), *extra]


def lock(name, blocking=False):
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE, 0o700)
    stream = (STATE / name).open('a')
    try:
        fcntl.flock(stream, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
    except BlockingIOError:
        stream.close()
        raise ValueError('This agent folder is already in use by another xcontrol group.')
    return stream


def managed(path, session):
    result = run('tmux', 'has-session', '-t', '=' + session, check=False)
    if result.returncode:
        detail = result.stderr.strip()
        if any(error in detail.lower() for error in ('operation not permitted', 'permission denied', 'access denied')):
            raise ValueError('Cannot access the tmux socket from this process. The group may still be running. '
                             'Agent sandbox permissions can block local sockets; restarting the group will not fix that. '
                             'Run xc status from your normal terminal to verify, then explicitly allow the tmux '
                             'socket in the agent permission settings if appropriate. Details: ' + detail)
        if detail and not any(error in detail.lower() for error in ('no server running', 'no such file or directory', 'can\'t find session', 'connection refused')):
            raise ValueError('Cannot query tmux: ' + detail)
        return False
    if tmux('show-options', '-qv', '-t', session, '@xcontrol_config') != str(path):
        raise ValueError('Existing tmux session is not owned by this configuration.')
    return True


def peers(session):
    raw = tmux('list-panes', '-t', session + ':agents', '-F', '#{@xcontrol_id}\t#{pane_id}\t#{pane_current_command}\t#{pane_dead}')
    return [line.split('\t') for line in raw.splitlines()]


def send(session, ident, message):
    matches = [p for p in peers(session) if p[0] == ident]
    if len(matches) != 1:
        raise ValueError(f'No unique live pane for agent {ident}.')
    if matches[0][3] == '1' or matches[0][2] in ('bash', 'sh', 'zsh', 'fish'):
        raise ValueError('Agent is not running; refusing to paste a message into a shell.')
    if not message.strip() or len(message.encode()) > 65536:
        raise ValueError('Message must be nonempty and at most 64 KiB.')
    # Bracketed paste prevents embedded newlines from becoming separate submissions.
    pane = matches[0][1]
    buffer = 'xc-' + os.urandom(8).hex()
    subprocess.run(['tmux', 'load-buffer', '-b', buffer, '-'], input=message, text=True, check=True)
    try:
        tmux('paste-buffer', '-p', '-b', buffer, '-t', pane)
        tmux('send-keys', '-t', pane, 'Enter')
    finally:
        tmux('delete-buffer', '-b', buffer, check=False)


def pane(filename, ident, selected=None):
    path, session, agents = load(filename)
    agent = next(a for a in agents if a['id'] == ident)
    if agent['agent'] == 'auto':
        if selected not in agent['candidates']:
            raise ValueError('Missing or invalid resolved auto agent; reopen the group.')
        agent['agent'] = selected
        if selected not in BUILTINS:
            agent['resume'] = 'new'
    key = hashlib.sha256((agent['agent'] + ':' + agent['folder']).encode()).hexdigest()
    with lock(key + '.lock', blocking=True):
        os.chdir(agent['folder'])
        os.environ['XCONTROL_CONFIG'] = str(path)
        os.environ['XCONTROL_AGENT'] = ident
        os.environ['XCONTROL_SESSION'] = session
        print(f"xcontrol · {ident} · {agent['agent']}: {agent.get('role', '')}", flush=True)
        print(f"Peers: xc status {shlex.quote(str(path))}", flush=True)
        # close_fds keeps the launcher lock out of the agent's descendants.
        return subprocess.call(command(agent))


def directory_config(directory, action):
    folder = Path(directory).expanduser().resolve(strict=True)
    if not folder.is_dir():
        raise ValueError('Expected a project directory.')
    digest = hashlib.sha256(str(folder).encode()).hexdigest()
    target = STATE / 'quickstart' / digest / 'project.agents'
    if target.exists() or action != 'open':
        return target
    prompt = """Help me set up xcontrol for this project. First read project instructions and inspect
this directory and its immediate child folders, read-only. Check which of codex,
copilot, and claude are installed using command -v. Other CLI agents can also be
configured explicitly, with their documented args; do not guess availability.
Suggest a small team with useful roles and separate folders/worktrees when the
same CLI would work in the same repository. Ask me to confirm the folders and
agents before writing a project .agents file. Do not launch peers, change source
files, build, deploy, or publish anything during this setup.

The .agents format is TOML. Example:
name = "myapp"
[[agents]]
id = "android"
folder = "./myapp-android"
agent = "codex"
role = "Android app; coordinate APIs with server."
[[agents]]
id = "server"
folder = "./myapp-server"
agent = "copilot"
role = "Server APIs; coordinate with android."

Resolve relative folders from the configuration file location. Use only existing
folders, or ask before creating worktrees. agent = "auto" optionally accepts
candidates = ["codex", "copilot", "claude"] and tests access with small model
calls. Run xc check on the proposed file once written. Explain how to launch it
with xc <file>.agents. Agents can discover peers with xc status "$XCONTROL_CONFIG"
and communicate with xc send "$XCONTROL_CONFIG" <agent-id> "message". Roles are
printed, not automatically submitted as prompts. Never include secrets in the configuration. Codex panes bypass approvals and sandboxing by default;
set bypass = false on Codex or auto agents to inherit normal Codex permissions.
For auto agents this setting applies only if Codex is selected.
"""
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    config = ('name = "setup"\n[[agents]]\nid = "setup"\nfolder = ' + json.dumps(str(folder), ensure_ascii=False)
              + '\nagent = "auto"\nresume = "new"\nrole = "Project setup and .agents configuration"\nprompt = '
              + json.dumps(prompt) + '\n')
    # Publish a complete file atomically without overwriting another launch.
    with tempfile.NamedTemporaryFile(mode='w', dir=target.parent, delete=False) as stream:
        temporary = Path(stream.name)
        stream.write(config)
    try:
        try:
            os.link(temporary, target)
        except FileExistsError:
            pass
    finally:
        temporary.unlink()
    print(f'Setup workspace: {folder}', file=sys.stderr)
    return target


def main():
    if len(sys.argv) in (4, 5) and sys.argv[1] == '--pane':
        return pane(*sys.argv[2:])
    parser = argparse.ArgumentParser(description=__doc__, epilog='Examples: xc myapp.agents | xc status myapp.agents | xc send myapp.agents ios "Review the shared API"')
    parser.add_argument('action_or_file', nargs='?', help='directory, project.agents, check, availability, status, send, or stop')
    parser.add_argument('rest', nargs='*')
    parser.add_argument('--detach', action='store_true', help='start without attaching')
    parser.add_argument('-k', '--kill', action='store_true', help='close this project group')
    args = parser.parse_args()
    if args.action_or_file is None:
        if args.detach or args.kill:
            parser.error('A directory or .agents file is required.')
        parser.print_help()
        return 0
    action = args.action_or_file
    if action in ('check', 'availability', 'status', 'send', 'stop'):
        if not args.rest:
            parser.error('A .agents file is required.')
        filename, *extra = args.rest
    else:
        filename, extra, action = action, args.rest, ('stop' if args.kill else 'open')
    if action == 'send':
        if len(extra) != 2:
            parser.error('Use xc send project.agents agent-id "message".')
    elif extra:
        parser.error('Unexpected arguments.')
    if Path(filename).expanduser().is_dir():
        if action not in ('open', 'status', 'send', 'stop'):
            parser.error('Use an .agents file for check or availability.')
        if not shutil.which('tmux'):
            raise ValueError('Missing dependency: tmux.')
        filename = directory_config(filename, action)
    path, session, agents = load(filename)
    if action == 'check':
        print(f'Valid: {path} ({len(agents)} agents; session {session})')
        return 0
    if action == 'availability':
        cache = {}
        for agent in agents:
            for engine in agent['candidates'] if agent['agent'] == 'auto' else [agent['agent']]:
                if engine not in cache:
                    cache[engine] = availability(engine, agent['checks'], path.parent)
                    print(f'{engine}\t{cache[engine]}')
        return 0
    if not shutil.which('tmux'):
        raise ValueError('Missing dependency: tmux.')
    if action in ('status', 'send', 'stop'):
        if not managed(path, session):
            raise ValueError('Project group is not running.')
        if action == 'status':
            for ident, target, process, dead in peers(session):
                engine = tmux('show-options', '-pqv', '-t', target, '@xcontrol_engine')
                print(f'{ident}\t{target}\t{process}\t' + ('exited' if dead == '1' else 'running') + f'\t{engine}')
        elif action == 'send':
            send(session, *extra)
        else:
            tmux('kill-session', '-t', '=' + session)
            print('Closed project group; saved CLI conversations remain.')
        return 0
    with lock('launcher.lock', blocking=True):
        if not managed(path, session):
            agents = resolve_agents(agents, path)
            # Hold all workspace locks until each pane has been created. Panes take
            # ownership afterwards; a simultaneous launch is serialized above.
            guards = []
            try:
                for agent in agents:
                    key = hashlib.sha256((agent['agent'] + ':' + agent['folder']).encode()).hexdigest()
                    guards.append(lock(key + '.lock'))
                for index, agent in enumerate(agents):
                    cmd = shlex.join([sys.executable, str(SCRIPT), '--pane', str(path), agent['id'], agent['agent']])
                    if index == 0:
                        target = tmux('new-session', '-d', '-s', session, '-n', 'agents', '-c', agent['folder'], '-x', '200', '-y', '50', '-P', '-F', '#{pane_id}', cmd)
                        tmux('set-option', '-t', session, '@xcontrol_config', str(path))
                        tmux('set-option', '-t', session, 'mouse', 'on')
                        tmux('set-option', '-t', session, 'pane-border-status', 'top')
                        tmux('set-option', '-t', session, 'pane-border-format', ' #{pane_title} ')
                    else:
                        target = tmux('split-window', '-t', target, '-c', agent['folder'], '-P', '-F', '#{pane_id}', cmd)
                    tmux('set-option', '-p', '-t', target, '@xcontrol_id', agent['id'])
                    tmux('set-option', '-p', '-t', target, '@xcontrol_engine', agent['agent'])
                    tmux('select-pane', '-t', target, '-T', agent['id'] + ' · ' + agent['agent'])
                    tmux('select-layout', '-t', session + ':agents', 'tiled')
                tmux('select-pane', '-t', peers(session)[0][1])
            except BaseException:
                # Only remove a session whose ownership marker we set.
                if managed(path, session):
                    tmux('kill-session', '-t', '=' + session)
                raise
            finally:
                for guard in guards:
                    guard.close()
    if args.detach:
        print(session)
        return 0
    if os.environ.get('TMUX'):
        return subprocess.call(['tmux', 'switch-client', '-t', '=' + session])
    return subprocess.call(['tmux', 'attach-session', '-t', '=' + session])


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, tomllib.TOMLDecodeError, subprocess.CalledProcessError) as exc:
        print(f'xcontrol: {exc}' + (f'\n{exc.stderr.strip()}' if isinstance(exc, subprocess.CalledProcessError) and exc.stderr else ''), file=sys.stderr)
        sys.exit(1)
